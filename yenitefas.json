    {
      "parameters": {
        "operation": "executeQuery",
        "query": "SELECT code, FIYAT, tarih \nFROM tefas_fund_details \nWHERE tarih >= DATE_SUB(CURDATE(), INTERVAL 40 DAY) -- \nORDER BY code, tarih DESC;",
        "options": {}
      },
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.5,
      "position": [
        5360,
        1776
      ],
      "id": "92fbb633-9329-45d0-b8e8-bf1085e0d691",
      "name": "40 günlük veri"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst grouped = {};\n\nitems.forEach(item => {\n    const code = item.json.code;\n    if (!grouped[code]) grouped[code] = [];\n    grouped[code].push(item.json);\n});\n\nconst results = [];\n\nfor (const code in grouped) {\n    const history = grouped[code];\n    if (history.length < 2) continue;\n\n    const prices = history.map(i => parseFloat(i.FIYAT) || 0);\n    const todayPrice = prices[0];\n    const todayDate = history[0].tarih;\n\n    let upStreak = 0;\n    let downStreak = 0;\n    let streakStartPrice = todayPrice;\n\n    if (prices[0] > prices[1]) {\n        for (let i = 0; i < prices.length - 1; i++) {\n            if (prices[i] > prices[i + 1]) {\n                upStreak++;\n                streakStartPrice = prices[i + 1];\n            } else break;\n        }\n    } else if (prices[0] < prices[1]) {\n        for (let i = 0; i < prices.length - 1; i++) {\n            if (prices[i] < prices[i + 1]) {\n                downStreak++;\n                streakStartPrice = prices[i + 1];\n            } else break;\n        }\n    }\n\n    let changePercent = 0;\n    if (streakStartPrice !== 0 && !isNaN(streakStartPrice)) {\n        changePercent = ((todayPrice - streakStartPrice) / streakStartPrice) * 100;\n    }\n\n    results.push({\n        json: {\n            fund_code: code,\n            up_streak: upStreak,\n            down_streak: downStreak,\n            change_percent: (isNaN(changePercent) || !isFinite(changePercent)) ? \"0.0000\" : changePercent.toFixed(4),\n            last_price: isNaN(todayPrice) ? 0 : todayPrice,\n            analysis_date: todayDate\n        }\n    });\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5568,
        1904
      ],
      "id": "a02aa31d-dfef-434a-b4a7-50188617a985",
      "name": "yükseliş analizi"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO tefas_trend_analysis \n(fund_code, up_streak, down_streak, change_percent, last_price, analysis_date)\nVALUES \n('{{ $json[\"fund_code\"] }}', {{ $json[\"up_streak\"] }}, {{ $json[\"down_streak\"] }}, {{ $json[\"change_percent\"] }}, {{ $json[\"last_price\"] }}, '{{ $json[\"analysis_date\"] }}')\nON DUPLICATE KEY UPDATE \nup_streak = VALUES(up_streak),\ndown_streak = VALUES(down_streak),\nchange_percent = VALUES(change_percent),\nlast_price = VALUES(last_price);",
        "options": {}
      },
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.5,
      "position": [
        5760,
        1904
