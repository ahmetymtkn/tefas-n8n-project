    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "INSERT INTO tefas_trend_analysis \n  (fund_code, period_days, change_percent, last_price, analysis_date)\nVALUES \n  (\n    '{{ $json[\"fund_code\"] }}',\n    {{ $json[\"period_days\"] }},\n    {{ $json[\"change_percent\"] }},\n    {{ $json[\"last_price\"] }},\n    '{{ $json[\"analysis_date\"] }}'\n  )\nON DUPLICATE KEY UPDATE \n  change_percent = VALUES(change_percent),\n  last_price     = VALUES(last_price);",
        "options": {}
      },
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.5,
      "position": [
        7040,
        1776
      ],
      "id": "0c068bf0-1166-4e76-a97d-3aba1ea21704",
      "name": "sql kayıt1"
    },
    {
      "parameters": {
        "operation": "executeQuery",
        "query": "WITH ranked AS (\n    SELECT \n        code,\n        FIYAT,\n        tarih,\n        ROW_NUMBER() OVER (\n            PARTITION BY code \n            ORDER BY tarih DESC\n        ) AS rn\n    FROM tefas_fund_details\n)\n\nSELECT code, FIYAT, tarih\nFROM ranked\nWHERE rn <= 30\nORDER BY code, tarih DESC;",
        "options": {}
      },
      "type": "n8n-nodes-base.mySql",
      "typeVersion": 2.5,
      "position": [
        6640,
        1872
      ],
      "id": "ab49099c-d4e3-4330-bd46-525c9c276f8f",
      "name": "30 günlük veri",
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst grouped = {};\n\nitems.forEach(item => {\n    const code = item.json.code;\n    if (!grouped[code]) grouped[code] = [];\n    grouped[code].push(item.json);\n});\n\nconst PERIODS = [2, 3, 5, 7, 14, 21];\nconst results = [];\n\nfor (const code in grouped) {\n    const history = grouped[code];\n    if (history.length < 2) continue;\n\n    const todayDate = history[0].tarih;\n\n    for (const period of PERIODS) {\n        // Tam olarak `period` kadar gün olmalı\n        if (history.length < period) continue;\n\n        const slice = history.slice(0, period);\n        const prices = slice.map(i => parseFloat(i.FIYAT));\n\n        \n        let allUp = true;\n        for (let i = 0; i < prices.length - 1; i++) {\n            if (prices[i] <= prices[i + 1]) {\n                allUp = false;\n                break;\n            }\n        }\n\n        if (!allUp) continue;\n\n        const todayPrice = prices[0];\n        const startPrice = prices[period - 1];\n\n        const changePercent = ((todayPrice - startPrice) / startPrice) * 100;\n\n        if (!isFinite(changePercent) || isNaN(changePercent) || changePercent <= 0) continue;\n\n        results.push({\n            json: {\n                fund_code: code,\n                period_days: period,\n                change_percent: parseFloat(changePercent.toFixed(4)),\n                last_price: todayPrice,\n                analysis_date: todayDate\n            }\n        });\n    }\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        6848,
        1776
      ],
      "id": "db371fda-b3cd-4e45-b2bd-1e42837953fe",
      "name": "yükseliş  analiz"
    },
    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst grouped = {};\n\nitems.forEach(item => {\n    const code = item.json.code;\n    if (!grouped[code]) grouped[code] = [];\n    grouped[code].push(item.json);\n});\n\nconst PERIODS = [3, 5, 7, 14, 21, 30];\nconst results = [];\n\nfor (const code in grouped) {\n    const history = grouped[code];\n    if (history.length < 2) continue;\n\n    const todayDate = history[0].tarih;\n\n    for (const period of PERIODS) {\n        const slice = history.slice(0, period);\n        if (slice.length < 2) continue;\n\n        const prices = slice.map(i => parseFloat(i.FIYAT) || 0);\n        const todayPrice = prices[0];\n        const oldestPrice = prices[prices.length - 1];\n\n        let upDaysCount = 0;\n        let downDaysCount = 0;\n\n        for (let i = 0; i < prices.length - 1; i++) {\n            if (prices[i] > prices[i + 1]) upDaysCount++;\n            else if (prices[i] < prices[i + 1]) downDaysCount++;\n        }\n\n        let totalReturn = 0;\n        if (oldestPrice !== 0 && !isNaN(oldestPrice)) {\n            totalReturn = ((todayPrice - oldestPrice) / oldestPrice) * 100;\n        }\n\n        results.push({\n            json: {\n                fund_code: code,\n                period_days: period,\n                up_days_count: upDaysCount,\n                down_days_count: downDaysCount,\n                total_return: (isNaN(totalReturn) || !isFinite(totalReturn))\n                    ? \"0.0000\"\n                    : totalReturn.toFixed(4),\n                analysis_date: todayDate\n            }\n        });\n    }\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        6848,
        2016
      ],
