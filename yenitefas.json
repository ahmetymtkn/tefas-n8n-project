    {
      "parameters": {
        "jsCode": "const items = $input.all();\nconst grouped = {};\n\nitems.forEach(item => {\n    const code = item.json.code;\n    if (!grouped[code]) grouped[code] = [];\n    grouped[code].push(item.json);\n});\n\nconst results = [];\n\nfor (const code in grouped) {\n    const history = grouped[code];\n    if (history.length < 2) continue;\n\n    const prices = history.map(i => parseFloat(i.FIYAT) || 0);\n    const todayPrice = prices[0];\n    const oldestPrice = prices[prices.length - 1];\n    const todayDate = history[0].tarih;\n\n    let upDaysCount = 0;\n    let downDaysCount = 0;\n\n    for (let i = 0; i < prices.length - 1; i++) {\n        if (prices[i] > prices[i + 1]) {\n            upDaysCount++;\n        } else if (prices[i] < prices[i + 1]) {\n            downDaysCount++;\n        }\n    }\n\n    let totalReturn = 0;\n    if (oldestPrice !== 0 && !isNaN(oldestPrice)) {\n        totalReturn = ((todayPrice - oldestPrice) / oldestPrice) * 100;\n    }\n\n    results.push({\n        json: {\n            fund_code: code,\n            up_days_count: upDaysCount,\n            down_days_count: downDaysCount,\n            total_return: (isNaN(totalReturn) || !isFinite(totalReturn)) ? \"0.0000\" : totalReturn.toFixed(4),\n            analysis_date: todayDate\n        }\n    });\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        5568,
        1680
      ],
      "id": "07f417a5-02ec-4a09-bef1-f0ae1152521b",
      "name": "yükseliş ve düşüş analiz"
    },
    {
