    {
      "parameters": {
        "jsCode": "const items = [];\nconst today = new Date();\ntoday.setHours(0, 0, 0, 0);\n\nconst absoluteLimit = new Date();\nabsoluteLimit.setFullYear(today.getFullYear() - 5);\nabsoluteLimit.setHours(0, 0, 0, 0);\n\nlet current = new Date(absoluteLimit);\n\nconst formatDate = (date) => {\n    const d = String(date.getDate()).padStart(2, '0');\n    const m = String(date.getMonth() + 1).padStart(2, '0');\n    const y = date.getFullYear();\n    return `${y}${m}${d}`;\n};\n\nwhile (current < today) {\n    const startDate = formatDate(current);\n    let nextDate = new Date(current);\n    const day = current.getDate();\n\n    if (day < 5) {\n        nextDate.setDate(5);\n    } else if (day < 15) {\n        nextDate.setDate(15);\n    } else if (day < 25) {\n        nextDate.setDate(25);\n    } else {\n        nextDate.setMonth(nextDate.getMonth() + 1);\n        nextDate.setDate(5);\n    }\n\n    if (nextDate > today) {\n        nextDate = new Date(today);\n    }\n\n    items.push({\n        json: {\n            startDate: startDate,\n            endDate: formatDate(nextDate)\n        }\n    });\n\n    current = new Date(nextDate);\n}\n\nreturn items;"
      },
