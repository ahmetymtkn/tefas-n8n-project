      "name": "kayitli tarihler"
    },
    {
      "parameters": {
        "jsCode": "const existingDates = new Set($input.all().map(item => item.json.tarih));\nconst results = [];\nconst today = new Date();\nconst startDate = new Date();\n\nstartDate.setFullYear(today.getFullYear() - 5);\n\nlet currentDate = new Date(startDate);\n\nwhile (currentDate <= today) {\n  const dayOfWeek = currentDate.getDay();\n\n  // 0 = Pazar, 6 = Cumartesi\n  if (dayOfWeek !== 6 && dayOfWeek !== 0) {\n\n    // ISO yerine LOCAL tarih üret (kayma yok)\n    const year = currentDate.getFullYear();\n    const month = String(currentDate.getMonth() + 1).padStart(2, '0');\n    const day = String(currentDate.getDate()).padStart(2, '0');\n\n    const dateString = `${year}-${month}-${day}`;\n\n    if (!existingDates.has(dateString)) {\n      results.push({\n        json: {\n          missing_date: dateString\n        }\n      });\n    }\n  }\n\n  currentDate.setDate(currentDate.getDate() + 1);\n}\n\nreturn results;"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        3952,
        1840
      ],
      "id": "63c33a3f-6668-43fe-b275-1e6d96ee6a77",
      "name": "olmayan tarihler"
    },
    {
      "parameters": {
        "jsCode": "for (const item of $input.all()) {\n  const dateStr = item.json.missing_date;\n\n  if (dateStr) {\n    const formattedDate = dateStr.replace(/-/g, '');\n    \n    item.json.startDate = formattedDate;\n    item.json.endDate = formattedDate;\n    \n    delete item.json.missing_date;\n  }\n}\n\nreturn $input.all();"
      },
