    {
      "parameters": {
        "jsCode": "function toNumber(x) {\n  if (x === undefined || x === null) return null;\n  const n = Number(x);\n  return Number.isFinite(n) ? n : null;\n}\n\ntry {\n  const input = items[0]?.json ?? {};\n\n  const resultList = Array.isArray(input.resultList)\n    ? input.resultList\n    : [];\n\n  if (!resultList.length) {\n    return [{\n      json: {\n        error: \"resultList boş veya bulunamadı\"\n      }\n    }];\n  }\n\n  const allNames = [];\n  const allValues = [];\n\n  for (const row of resultList) {\n    const name = row?.fonKodu ?? row?.Unvan ?? null;\n    const value = toNumber(row?.fonTurGetiri);\n\n    if (name !== null && value !== null) {\n      allNames.push(String(name));\n      allValues.push(value);\n    }\n  }\n\n  return [{\n    json: {\n      fund_code: $('When Executed by Another Workflow').first().json.code,\n      period_id: $('Loop Over Items').first().json.period,\n      comparison_names: JSON.stringify(allNames),\n      comparison_values: JSON.stringify(allValues),\n      fetched_at: new Date().toISOString().split('T')[0]\n    }\n  }];\n\n} catch (error) {\n  return [{\n    json: {\n      error: \"İşlem sırasında hata: \" + error.message\n    }\n  }];\n}\n"
      },
